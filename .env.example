# Copy to .env.local (gitignored) and fill in. NEXT_PUBLIC_* vars are exposed to the browser by Next.js
# (inlined at build time). Leave the key EMPTY to disable analytics entirely (dev/CI safe).

# --- Browser analytics (cookieless PostHog, client-side) ---
# PUBLIC ingestion key from PostHog → Settings → Project → "Project API Key" (phc_...). Write-only
# (can only send events, never read/admin), so it is safe in the browser.
NEXT_PUBLIC_POSTHOG_KEY=
# Phase 1: connect DIRECTLY to PostHog EU (no proxy, no DNS). To flip on the ad-blocker-resistant
# reverse proxy later (the /ingest rewrite is already wired in next.config.ts), set this to: /ingest
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Source-map upload to PostHog Error Tracking (BUILD-ONLY SECRETS — never NEXT_PUBLIC_, never commit) ---
# Set these in the Vercel *build* environment so production stack traces are readable. When
# POSTHOG_API_KEY is unset (local/dev builds) the upload is skipped and the build is unaffected.
#   POSTHOG_API_KEY     Personal API key with WRITE access on "Error tracking"
#                       (PostHog → Settings → Personal API keys)
#   POSTHOG_PROJECT_ID  Numeric project id (PostHog → Settings → Project)
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
